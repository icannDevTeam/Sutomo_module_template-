  "cards": [
    { "dot": "cyan", "title": "Ranking and invitation limits", "items": [
      "Priority: VIP, pinned teacher preferences, global preferred, subject, department, then campus pool. Restricted teachers sink within each tier.",
      "Approved leave, existing approved cover and absence attendance are hard conflicts. Overlapping pending/accepted duties are soft conflicts.",
      "Defaults: 24-hour response window, 15 invitations and 5 interested responses. Previously invited teachers are excluded from later rounds."
    ] },
    { "dot": "amber", "title": "Interest, closure and expiry are separate", "items": [
      "Accept means interested, never automatic assignment. Principal selection requires the chosen offer still to be interested.",
      "Cap reached or manual Close Search cancels pending offers but retains interested offers for selection.",
      "Assignment marks the chosen offer assigned, sets substitute_teacher_id, and cancels other pending/interested offers. It does not change leave.status.",
      "Expired signatures are rejected by signed middleware. The controller also checks offer expiry; this diagram does not claim a scheduled expiry job."
    ] },
    { "dot": "rose", "title": "Delivery is not guaranteed", "items": [
      "Mail is sent synchronously when a teacher has an email. Exceptions are reported but offers remain stored.",
      "The template defaults MAIL_MAILER to log, so external delivery depends on local mail configuration.",
      "Cancellation updates database status; assignFromInterested contains no email notification to the other teachers."
    ] }
  ]
