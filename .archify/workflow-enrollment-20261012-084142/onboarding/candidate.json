  "cards": [
    { "dot": "cyan", "title": "Track A - interview-first onboarding", "items": [
      "TK, playgroup, pre-nursery and non-Plus SD use Track A; all other campus / stream combinations use Track B.",
      "Passing the interview records interview.passed_at, unlocking the combined payment in the UI.",
      "Combined registration + donation activates the record directly; books, observation and tuition are not Track A stages."
    ] },
    { "dot": "emerald", "title": "Track B - complete the displayed stages in order", "items": [
      "Stages are computed from Application.meta; the first incomplete stage is current and later ones are locked in the UI.",
      "Observation completion counts at least five present marks, not merely five calendar days.",
      "Student ID issuance writes a tuition VA and an audit log; tuition confirmation sets Application.status=activated."
    ] },
    { "dot": "amber", "title": "What activation and reinstatement actually mean", "items": [
      "Activation here updates an Application; these actions do not create a Student record.",
      "Cross-tab staff actions can waitlist, withdraw or reinstate. The top-row review actions are not mandatory onboarding stages.",
      "Reinstatement changes status and clears waitlisted; it does not erase previously completed metadata.",
      "Displayed stage locks are UI progression rules, not a claim of server-side action enforcement."
    ] }
