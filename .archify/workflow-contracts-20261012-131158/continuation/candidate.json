  "cards": [
    { "dot": "cyan", "title": "Annual continuation is not PKWT tier renewal", "items": [
      "Contract Continuation selects non-archived LOIs for Guru SK / permanent teachers in the current academic year.",
      "Send changes LOI status and timestamps; that action alone is not an email-delivery implementation.",
      "LOI signing requires status sent and the teacher's bound user account. A decline enters the separate follow-up flow."
    ] },
    { "dot": "amber", "title": "Yayasan boundary and revision loop", "items": [
      "The repository tracks submission, document path and upload timestamp, but no current application action writes the Yayasan contract upload.",
      "The external document/re-upload arrows are required hand-offs, not a working local uploader or automated Yayasan API.",
      "Uploaded is not accepted. The principal accepts the document or records needs_revision with a non-empty issue note."
    ] },
    { "dot": "emerald", "title": "Final gate is explicit", "items": [
      "Agreement signing requires an uploaded, principal-accepted contract, no prior agreement signature, a valid name, and the named teacher account.",
      "Signing stores name, time and IP and automatically timestamps Buku Induk / HR handoff. A manual Record Buku Induk action also exists after signing.",
      "Mark Complete additionally requires signed LOI, Yayasan submission, upload, accepted review, agreement signature and Buku Induk timestamp; it cannot already be completed.",
      "Continuation completion timestamps the LOI; it does not spawn a new TeacherContract."
    ] }
  ]
