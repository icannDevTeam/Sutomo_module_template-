  "cards": [
    { "dot": "cyan", "title": "Health is an advisory diagnostic surface", "items": [
      "Health reads cached cell conflicts and compares stored subject hours against requirements for classes already present in lessons.",
      "Subject deficits are errors, excess hours and over-cap loads are warnings, and below-half-cap teacher loads are informational.",
      "Missing whole classes with no lessons are not enumerated here. The UI names unfilled_required, but the current report does not emit that category.",
      "Cell issues link to teacher/session/period/day. Deficit issues have no precise cell; the link opens the default builder context."
    ] },
    { "dot": "amber", "title": "Publishing does not wait for errors to disappear", "items": [
      "Despite must-fix wording in the Health UI, neither the Publish button nor PublishService rejects unresolved errors.",
      "Publishing transactionally saves a snapshot payload and sets definition status published; remaining conflict cells produce a warning.",
      "Conflict count measures lessons with non-empty flags, not the number of individual issues. The frozen payload does not include those flags.",
      "Published status does not disable edits or generation on the live definition; subsequent changes do not rewrite the captured snapshot.",
      "Print/export all teachers renders stacked live teacher sheets and invokes browser printing; it is separate from snapshot publishing."
    ] }
  ]
